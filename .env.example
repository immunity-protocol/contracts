# Secrets are managed via `npx hardhat keystore set <KEY>` (Hardhat 3 keystore).
# This file documents the keys the project expects but is not loaded at runtime.

# Base Sepolia testnet RPC (default: https://sepolia.base.org)
IMMUNITY_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Base mainnet RPC (default: https://mainnet.base.org) — not used until post-audit
IMMUNITY_BASE_RPC=https://mainnet.base.org

# Deployer private key (hex, 0x-prefixed; fund Base Sepolia via https://www.alchemy.com/faucets/base-sepolia)
IMMUNITY_DEPLOYER_PK=0x...
